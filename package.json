{
  "name": "shopsphere",
  "version": "1.0.0",
  "description": "ShopSphere - Modern Full-Stack E-Commerce Application",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "seed": "npm run seed --prefix server",
    "install-all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["ecommerce", "mern", "react", "tailwind", "express", "mongodb"],
  "author": "ShopSphere Team",
  "license": "MIT"
}

